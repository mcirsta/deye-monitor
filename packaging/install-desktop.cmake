# Install the development checkout's launcher and original vector icon for this user.
if(DEFINED ENV{XDG_DATA_HOME} AND NOT "$ENV{XDG_DATA_HOME}" STREQUAL "")
    set(data_home "$ENV{XDG_DATA_HOME}")
elseif(DEFINED ENV{HOME} AND NOT "$ENV{HOME}" STREQUAL "")
    set(data_home "$ENV{HOME}/.local/share")
else()
    message(FATAL_ERROR "Set XDG_DATA_HOME or HOME to install the desktop launcher")
endif()
set(applications "${data_home}/applications")
set(icons "${data_home}/icons/hicolor/scalable/apps")
file(MAKE_DIRECTORY "${applications}" "${icons}")
file(COPY_FILE "${DEYE_LAUNCHER}" "${applications}/com.deye.monitor.desktop" ONLY_IF_DIFFERENT)
file(COPY_FILE "${DEYE_ICON}" "${icons}/com.deye.monitor.svg" ONLY_IF_DIFFERENT)
find_program(desktop_database update-desktop-database)
if(desktop_database)
    execute_process(COMMAND "${desktop_database}" "${applications}" COMMAND_ERROR_IS_FATAL ANY)
endif()
message(STATUS "Installed Deye Monitor launcher and SVG icon in ${data_home}")
